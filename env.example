# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Sessions ──────────────────────────────────────────────────────────────────
# Long random string. Signs the session cookie that holds the expert's mobile.
SESSION_SECRET=replace_with_a_long_random_string
SESSION_MAX_AGE_SECONDS=43200
# Set true once served over HTTPS.
COOKIE_SECURE=false

# ── Redash ────────────────────────────────────────────────────────────────────
REDASH_BASE_URL=https://analytics.getlokalapp.com
REDASH_API_KEY=6qb9R2mnqjOLz0y7tGX4NeuLPrYKGvQW3XCdmojF

# Query 02 — expert metrics (one row per expert, includes the `daily` array,
# the within-language `signals` array and the reset clock).
REDASH_METRICS_QUERY_ID=19807

# Variable Pricing ranking query — already on a schedule. Only the tier is read.
REDASH_TIERS_QUERY_ID=18458

# How long each query result is held before re-polling Redash. Metrics move
# through the day; tiers only change at the weekly reset.
METRICS_CACHE_TTL_SECONDS=900
TIERS_CACHE_TTL_SECONDS=3600

REDASH_POLL_INTERVAL_MS=500
REDASH_POLL_MAX_TRIES=60

# ── Admin ─────────────────────────────────────────────────────────────────────
# Optional. If set, POST /api/cache/clear requires header x-admin-token.
ADMIN_TOKEN=
AUTH_MODE=mobile

# ── Google Sheets (earning tiers) ─────────────────────────────────────────────
# Paste the ENTIRE service-account key JSON as one line, starting with { and
# ending with }. Preferred over a mounted file — keeps all config in one
# Devtron secret with no volume mounts.
GOOGLE_CREDENTIALS_JSON=
